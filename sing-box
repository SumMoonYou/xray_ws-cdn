#!/usr/bin/env bash
set -e

APP="/usr/local/bin/sing-box"
CONF="/etc/sing-box/config.json"
CERT_DIR="/etc/sing-box/cert"
BACKUP_DIR="/etc/sing-box/backup"

# ==============================
# 基础检查
# ==============================
if [[ $EUID -ne 0 ]]; then
    echo "❌ 请使用 root 运行"
    exit 1
fi

mkdir -p "$CERT_DIR" "$BACKUP_DIR"

# ==============================
# 🎨 UI 菜单
# ==============================
clear

GREEN="\033[32m"
BLUE="\033[36m"
YELLOW="\033[33m"
RED="\033[31m"
PURPLE="\033[35m"
BOLD="\033[1m"
RESET="\033[0m"

echo -e "${BLUE}${BOLD}"
echo "┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓"
echo "┃        🚀 Sing-box 管理面板         ┃"
echo "┃     WS + TLS + VLESS + CF MODE      ┃"
echo "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛"
echo -e "${RESET}"

echo -e "${GREEN}📌 功能菜单：${RESET}"
echo "──────────────────────────────────────"
echo -e "  ${YELLOW}1)${RESET} 📦 安装 sing-box"
echo -e "  ${YELLOW}2)${RESET} 📄 查看配置"
echo -e "  ${YELLOW}3)${RESET} ⚙️ 修改配置"
echo -e "  ${YELLOW}4)${RESET} 🗑️ 卸载"
echo -e "  ${YELLOW}5)${RESET} 🔄 重启服务"
echo -e "  ${YELLOW}0)${RESET} 🚪 退出"
echo "──────────────────────────────────────"

echo -e "${PURPLE}💡 提示：首次使用建议选择 1 安装${RESET}"
echo ""

read -p "👉 请输入选项: " opt


# ==============================
# 工具函数（优化版）
# ==============================
gen_uuid() {
    cat /proc/sys/kernel/random/uuid 2>/dev/null || uuidgen
}

gen_path() {
    local p
    p=$(tr -dc a-z0-9 </dev/urandom | head -c 10)
    echo "/$p"
}

gen_link() {
    local uuid="$1"
    local domain="$2"
    local path="$3"
    echo "vless://${uuid}@${domain}:443?encryption=none&security=tls&type=ws&host=${domain}&path=${path}&sni=${domain}#${domain}"
}

backup_conf() {
    [[ -f "$CONF" ]] && cp "$CONF" "$BACKUP_DIR/config_$(date +%Y%m%d_%H%M%S).json"
}

is_installed() {
    systemctl is-enabled sing-box >/dev/null 2>&1
}

check_service() {
    systemctl is-active --quiet sing-box
}


# ==============================
# 安装
# ==============================
install() {

    echo "📦 安装 sing-box ..."
    bash <(curl -Ls https://sing-box.app/deb-install.sh)

    if ! command -v sing-box >/dev/null 2>&1; then
        echo "❌ 安装失败"
        exit 1
    fi

    read -p "🌐 输入域名: " DOMAIN

    UUID=$(gen_uuid)

    PATH_WS=$(gen_path)
    PATH_WS="${PATH_WS#/}"

    # 证书防呆
    [[ -s "$CERT_DIR/fullchain.pem" ]] && echo "⚠️ 检测到旧证书，将覆盖"

    echo "📌 粘贴 fullchain.pem (CTRL+D 结束):"
    cat > "$CERT_DIR/fullchain.pem"
    [[ ! -s "$CERT_DIR/fullchain.pem" ]] && { echo "❌ 证书为空"; exit 1; }

    echo "📌 粘贴 privkey.pem (CTRL+D 结束):"
    cat > "$CERT_DIR/privkey.pem"
    [[ ! -s "$CERT_DIR/privkey.pem" ]] && { echo "❌ 私钥为空"; exit 1; }

    backup_conf

    cat > "$CONF" <<EOF
{
  "log": { "level": "warn" },
  "inbounds": [{
    "type": "vless",
    "listen": "0.0.0.0",
    "listen_port": 443,
    "users": [{ "uuid": "$UUID" }],
    "transport": {
      "type": "ws",
      "path": "/$PATH_WS",
      "max_early_data": 2048
    },
    "tls": {
      "enabled": true,
      "server_name": "$DOMAIN",
      "certificate_path": "$CERT_DIR/fullchain.pem",
      "key_path": "$CERT_DIR/privkey.pem"
    }
  }],
  "outbounds": [{ "type": "direct" }]
}
EOF

    systemctl enable sing-box >/dev/null 2>&1
    systemctl restart sing-box

    if ! check_service; then
        echo "❌ 服务启动失败，请检查配置"
        exit 1
    fi

    echo "======================================="
    echo "🎉 安装完成"
    echo "DOMAIN: $DOMAIN"
    echo "UUID: $UUID"
    echo "PATH: /$PATH_WS"
    echo "======================================="

    gen_link "$UUID" "$DOMAIN" "/$PATH_WS"
}


# ==============================
# 查看
# ==============================
show() {
    echo "📄 当前配置："
    echo "--------------------------------"
    [[ -f "$CONF" ]] && cat "$CONF" || echo "配置不存在"
    echo ""
    systemctl status sing-box --no-pager || true
}


# ==============================
# 修改
# ==============================
modify() {

    echo "⚙️ 修改配置"

    read -p "🌐 新域名: " DOMAIN
    read -p "🔁 是否重新生成 UUID? (y/n): " r

    if [[ "$r" == "y" ]]; then
        UUID=$(gen_uuid)
    else
        UUID=$(grep -o '"uuid"[[:space:]]*:[[:space:]]*"[^"]*"' "$CONF" | cut -d'"' -f4)
        [[ -z "$UUID" ]] && UUID=$(gen_uuid)
    fi

    PATH_WS=$(gen_path)
    PATH_WS="${PATH_WS#/}"

    backup_conf

    cat > "$CONF" <<EOF
{
  "log": { "level": "warn" },
  "inbounds": [{
    "type": "vless",
    "listen": "0.0.0.0",
    "listen_port": 443,
    "users": [{ "uuid": "$UUID" }],
    "transport": {
      "type": "ws",
      "path": "/$PATH_WS",
      "max_early_data": 2048
    },
    "tls": {
      "enabled": true,
      "server_name": "$DOMAIN",
      "certificate_path": "$CERT_DIR/fullchain.pem",
      "key_path": "$CERT_DIR/privkey.pem"
    }
  }],
  "outbounds": [{ "type": "direct" }]
}
EOF

    systemctl restart sing-box

    echo "✔ 修改完成"
    echo "NEW LINK:"
    gen_link "$UUID" "$DOMAIN" "/$PATH_WS"
}


# ==============================
# 卸载（安全版）
# ==============================
uninstall() {

    read -p "⚠️ 确认卸载 sing-box? (y/n): " c
    [[ "$c" != "y" ]] && return

    systemctl stop sing-box || true
    systemctl disable sing-box || true

    rm -rf "$CONF" "$CERT_DIR" "$BACKUP_DIR"

    if command -v sing-box >/dev/null 2>&1; then
        rm -f "$(command -v sing-box)"
    fi

    echo "🗑️ 已卸载完成"
}


# ==============================
# 重启
# ==============================
restart() {
    systemctl restart sing-box
    check_service && echo "✔ 已重启成功" || echo "❌ 重启失败"
}


# ==============================
# 菜单执行
# ==============================
case $opt in
    1)
        if is_installed; then
            echo "❌ 已安装，请勿重复安装"
        else
            install
        fi
    ;;
    2) show ;;
    3) modify ;;
    4) uninstall ;;
    5) restart ;;
    0) exit 0 ;;
    *) echo "无效选项" ;;
esac
