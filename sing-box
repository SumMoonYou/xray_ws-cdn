#!/usr/bin/env bash
set -e

APP="/usr/local/bin/sing-box"
CONF="/etc/sing-box/config.json"
CERT_DIR="/etc/sing-box/cert"
BACKUP_DIR="/etc/sing-box/backup"

# ==============================
# 基础检查
# ==============================
if [[ $EUID -ne 0 ]]; then
    echo "❌ 请使用 root 运行"
    exit 1
fi

mkdir -p "$CERT_DIR" "$BACKUP_DIR"

# ==============================
# UI菜单
# ==============================
clear

GREEN="\033[32m"
BLUE="\033[36m"
YELLOW="\033[33m"
PURPLE="\033[35m"
RESET="\033[0m"

echo -e "${BLUE}"
echo "┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓"
echo "┃        🚀 Sing-box 管理面板         ┃"
echo "┃     WS + TLS + VLESS + CF MODE      ┃"
echo "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛"
echo -e "${RESET}"

echo -e "${GREEN}📌 功能菜单：${RESET}"
echo "1) 安装 sing-box"
echo "2) 查看配置"
echo "3) 修改配置"
echo "4) 卸载"
echo "5) 重启"
echo "0) 退出"

read -p "👉 选择: " opt


# ==============================
# 工具函数（性能版）
# ==============================
gen_uuid() {
    cat /proc/sys/kernel/random/uuid 2>/dev/null || uuidgen
}

gen_path() {
    echo "/$(tr -dc a-z0-9 </dev/urandom | head -c 10)"
}

gen_link() {
    local uuid="$1"
    local domain="$2"
    local port="$3"
    local path="$4"

    echo "vless://${uuid}@${domain}:${port}?encryption=none&security=tls&type=ws&host=${domain}&path=${path}&sni=${domain}#${domain}"
}

backup_conf() {
    [[ -f "$CONF" ]] && cp "$CONF" "$BACKUP_DIR/config_$(date +%Y%m%d_%H%M%S).json"
}

is_installed() {
    systemctl is-enabled sing-box >/dev/null 2>&1
}

check_service() {
    systemctl is-active --quiet sing-box
}


# ==============================
# 🔥 性能优化配置生成
# ==============================
build_config() {
cat > "$CONF" <<EOF
{
  "log": {
    "level": "warn",
    "timestamp": false
  },

  "dns": {
    "strategy": "ipv4_only",
    "independent_cache": true
  },

  "inbounds": [{
    "type": "vless",
    "listen": "0.0.0.0",
    "listen_port": $PORT,

    "users": [{
      "uuid": "$UUID",
      "flow": ""
    }],

    "transport": {
      "type": "ws",
      "path": "$PATH_WS",
      "max_early_data": 2048,
      "early_data_header_name": "Sec-WebSocket-Protocol"
    },

    "multiplex": {
      "enabled": true,
      "padding": true,
      "brutal": {
        "enabled": true,
        "up_mbps": 100,
        "down_mbps": 200
      }
    },

    "tls": {
      "enabled": true,
      "server_name": "$DOMAIN",
      "alpn": ["h2", "http/1.1"],
      "min_version": "1.2",
      "max_version": "1.3",
      "certificate_path": "$CERT_DIR/fullchain.pem",
      "key_path": "$CERT_DIR/privkey.pem"
    }
  }],

  "outbounds": [{
    "type": "direct"
  }],

  "route": {
    "final": "direct"
  },

  "experimental": {
    "cache_file": {
      "enabled": true
    }
  }
}
EOF
}


# ==============================
# 安装
# ==============================
install() {

    echo "📦 安装 sing-box ..."
    bash <(curl -Ls https://sing-box.app/deb-install.sh)

    command -v sing-box >/dev/null 2>&1 || { echo "❌ 安装失败"; exit 1; }

    read -p "🌐 输入域名: " DOMAIN
    read -p "🔌 输入端口(默认443): " PORT
    PORT=${PORT:-443}

    UUID=$(gen_uuid)
    PATH_WS=$(gen_path)

    echo "📌 粘贴 fullchain.pem:"
    cat > "$CERT_DIR/fullchain.pem"
    [[ ! -s "$CERT_DIR/fullchain.pem" ]] && { echo "❌ 证书为空"; exit 1; }

    echo "📌 粘贴 privkey.pem:"
    cat > "$CERT_DIR/privkey.pem"
    [[ ! -s "$CERT_DIR/privkey.pem" ]] && { echo "❌ 私钥为空"; exit 1; }

    backup_conf
    build_config

    systemctl enable sing-box >/dev/null 2>&1
    systemctl restart sing-box

    check_service || { echo "❌ 启动失败"; exit 1; }

    echo "=============================="
    echo "🎉 安装完成"
    echo "DOMAIN: $DOMAIN"
    echo "PORT: $PORT"
    echo "UUID: $UUID"
    echo "PATH: $PATH_WS"
    echo "=============================="

    gen_link "$UUID" "$DOMAIN" "$PORT" "$PATH_WS"
}


# ==============================
# 查看（带链接）
# ==============================
show() {

    echo "📄 配置："
    cat "$CONF" 2>/dev/null || echo "无配置"

    echo ""
    systemctl status sing-box --no-pager || true

    if [[ -f "$CONF" ]]; then
        DOMAIN=$(grep '"server_name"' "$CONF" | head -n1 | cut -d'"' -f4)
        PORT=$(grep '"listen_port"' "$CONF" | head -n1 | grep -o '[0-9]\+')
        UUID=$(grep -o '"uuid"[[:space:]]*:[[:space:]]*"[^"]*"' "$CONF" | cut -d'"' -f4)
        PATH_WS=$(grep '"path"' "$CONF" | head -n1 | cut -d'"' -f4)

        echo ""
        echo "🔗 VLESS链接："
        echo "--------------------------------"
        echo "vless://${UUID}@${DOMAIN}:${PORT}?encryption=none&security=tls&type=ws&host=${DOMAIN}&path=${PATH_WS}&sni=${DOMAIN}#${DOMAIN}"
        echo "--------------------------------"
    fi
}


# ==============================
# 修改
# ==============================
modify() {

    read -p "🌐 新域名: " DOMAIN
    read -p "🔌 端口(默认443): " PORT
    PORT=${PORT:-443}

    read -p "🔁 重新UUID(y/n): " r

    if [[ "$r" == "y" ]]; then
        UUID=$(gen_uuid)
    else
        UUID=$(grep -o '"uuid"[[:space:]]*:[[:space:]]*"[^"]*"' "$CONF" | cut -d'"' -f4)
        [[ -z "$UUID" ]] && UUID=$(gen_uuid)
    fi

    PATH_WS=$(gen_path)

    backup_conf
    build_config

    systemctl restart sing-box

    echo "✔ 修改完成"
    gen_link "$UUID" "$DOMAIN" "$PORT" "$PATH_WS"
}


# ==============================
# 卸载
# ==============================
uninstall() {

    read -p "确认卸载? (y/n): " c
    [[ "$c" != "y" ]] && return

    systemctl stop sing-box || true
    systemctl disable sing-box || true

    rm -rf "$CONF" "$CERT_DIR" "$BACKUP_DIR"

    echo "🗑️ 已卸载"
}


# ==============================
# 重启
# ==============================
restart() {
    systemctl restart sing-box
    check_service && echo "✔ OK" || echo "❌ FAIL"
}


# ==============================
# 执行
# ==============================
case $opt in
    1)
        is_installed && echo "已安装" || install
    ;;
    2) show ;;
    3) modify ;;
    4) uninstall ;;
    5) restart ;;
    0) exit 0 ;;
    *) echo "错误选项" ;;
esac
